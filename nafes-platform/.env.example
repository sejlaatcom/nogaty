# انسخ هذا الملف إلى .env (يُنشئه المثبّت تلقائياً) ولا ترفعه إلى أي مستودع عام
APP_NAME="منصة نافس التدريبية"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://nafes.example.edu.sa
APP_KEY=
APP_TIMEZONE=Asia/Riyadh
APP_PRETTY_URLS=true

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nafes_platform
DB_USERNAME=
DB_PASSWORD=

SESSION_LIFETIME=120
SESSION_SECURE=auto
UPLOAD_MAX_MB=5
